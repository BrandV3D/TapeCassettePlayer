<UserControl x:Class="EqualizerControlsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tape_Player"
        mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="EqButton" TargetType="Button">
            <Setter Property="Background" Value="#FF2A2A32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="EqToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#FF2A2A32"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentStartBrush}"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Background="{DynamicResource Bg1Brush}">
    <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="4" Margin="8">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{DynamicResource PanelGradTopColor}" Offset="0"/>
                <GradientStop Color="{DynamicResource PanelGradBottomColor}" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <DockPanel Margin="10">
            <!-- Top row: bypass toggle, reset, preamp knob, bass-boost knob -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <ToggleButton x:Name="BypassToggle" Style="{StaticResource EqToggle}" Content="EQ ON" IsChecked="True" Width="70"/>
                    <Button x:Name="ResetButton" Style="{StaticResource EqButton}" Content="Reset"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel Margin="10,0" HorizontalAlignment="Center">
                        <Grid Width="56" Height="56">
                            <Ellipse x:Name="PreampKnobEllipse" Width="52" Height="52" StrokeThickness="2" Cursor="Hand" Stroke="{DynamicResource HairlineBrush}">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#FF2A2A32" Offset="0"/>
                                        <GradientStop Color="#FF0A0A0F" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="{DynamicResource AccentStartColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.45"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Rectangle Width="3" Height="20" Fill="{DynamicResource AccentStartBrush}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,6,0,0" RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform>
                                    <RotateTransform x:Name="PreampKnobRotate" Angle="0"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <TextBlock Text="Preamp" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="10,0" HorizontalAlignment="Center">
                        <Grid Width="56" Height="56">
                            <Ellipse x:Name="BassBoostKnobEllipse" Width="52" Height="52" StrokeThickness="2" Cursor="Hand" Stroke="{DynamicResource HairlineBrush}">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#FF2A2A32" Offset="0"/>
                                        <GradientStop Color="#FF0A0A0F" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="{DynamicResource AccentEndColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.45"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Rectangle Width="3" Height="20" Fill="{DynamicResource AccentEndBrush}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,6,0,0" RadiusX="1.5" RadiusY="1.5" RenderTransformOrigin="0.5,1">
                                <Rectangle.RenderTransform>
                                    <RotateTransform x:Name="BassBoostKnobRotate" Angle="-135"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        <TextBlock Text="Bass Boost" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- Bottom row: presets -->
            <WrapPanel x:Name="PresetsPanel" DockPanel.Dock="Bottom" Margin="0,8,0,0" HorizontalAlignment="Center"/>

            <!-- Middle: one vertical slider per band, built in code-behind from the engine's
                 GraphicEqualizer so the frequencies always match what's actually being filtered. -->
            <StackPanel x:Name="BandsPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
        </DockPanel>
    </Border>
    </Grid>
</UserControl>
