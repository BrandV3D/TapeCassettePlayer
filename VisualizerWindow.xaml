<Window x:Class="VisualizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tape_Player"
        mc:Ignorable="d"
        Title="Visualizer" Width="460" Height="220" ResizeMode="CanResize"
        Background="#FF1E1E1E">
    <Border BorderBrush="#FF3A3A3A" BorderThickness="1" CornerRadius="4" Margin="8">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF0C1014" Offset="0"/>
                <GradientStop Color="#FF05060A" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid x:Name="ScopeRoot" ClipToBounds="True">
            <Canvas x:Name="GridLinesCanvas"/>
            <Canvas>
                <Polygon x:Name="WaveFill" Opacity="0.18">
                    <Polygon.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFB721FF" Offset="0"/>
                            <GradientStop Color="#FF00E5FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Polygon.Fill>
                </Polygon>
                <Polyline x:Name="WaveLine" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Polyline.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF00E5FF" Offset="0"/>
                            <GradientStop Color="#FFB721FF" Offset="0.55"/>
                            <GradientStop Color="#FFFF2D95" Offset="1"/>
                        </LinearGradientBrush>
                    </Polyline.Stroke>
                    <Polyline.Effect>
                        <DropShadowEffect Color="#FF00E5FF" BlurRadius="14" ShadowDepth="0" Opacity="0.75"/>
                    </Polyline.Effect>
                </Polyline>
                <Ellipse x:Name="LeadDot" Width="8" Height="8" Fill="White">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#FFFFFFFF" BlurRadius="12" ShadowDepth="0" Opacity="0.9"/>
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>
        </Grid>
    </Border>
</Window>
