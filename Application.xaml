<Application x:Class="Application"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Tape_Player"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Every window gets the cassette icon in its title bar/taskbar entry, to match the
             embedded exe icon (ApplicationIcon in the vbproj) - one Style instead of repeating
             Icon="/TapeCassette.ico" on Cassette/ControlsWindow/PlaylistWindow/MixtapeWindow/LoadMixtapeWindow. -->
        <Style TargetType="Window">
            <Setter Property="Icon" Value="/TapeCassette.ico"/>
        </Style>

        <!-- Tape-deck button skin: dark brushed-plastic buttons with a warm amber accent (like a
             deck's indicator LEDs) on hover/press, applied to every Button app-wide since there's
             no reason any window should keep the default flat system-gray look on this dark skin.
             The actual brushes come from whichever Themes/*.xaml ResourceDictionary ThemeManager
             has merged in (see ThemeManager.vb) - DynamicResource here (not StaticResource) is what
             lets switching themes re-skin every button live. -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonNormalBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ButtonTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="1.5" BlurRadius="3" Opacity="0.55"/>
                            </Border.Effect>
                            <Grid>
                                <!-- Thin top highlight for a subtle "raised plastic" gloss. -->
                                <Border BorderBrush="#26FFFFFF" BorderThickness="0,1,0,0" CornerRadius="5,5,0,0"
                                        Margin="1,1,1,0" VerticalAlignment="Top" Height="2"/>
                                <ContentPresenter x:Name="content" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                                   RenderTransformOrigin="0.5,0.5">
                                    <ContentPresenter.RenderTransform>
                                        <TranslateTransform/>
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource ButtonAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ButtonPressedBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource ButtonAccentBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="Black" Direction="270" ShadowDepth="0.5" BlurRadius="2" Opacity="0.3"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="content" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource ButtonAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ButtonDisabledBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="Effect" Value="{x:Null}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ButtonDisabledTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
