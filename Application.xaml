<Application x:Class="Application"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Tape_Player"
             StartupUri="Cassette.xaml">
    <Application.Resources>

        <!-- Every window gets the cassette icon in its title bar/taskbar entry, to match the
             embedded exe icon (ApplicationIcon in the vbproj) - one Style instead of repeating
             Icon="/TapeCassette.ico" on Cassette/ControlsWindow/PlaylistWindow/MixtapeWindow/LoadMixtapeWindow. -->
        <Style TargetType="Window">
            <Setter Property="Icon" Value="/TapeCassette.ico"/>
        </Style>

        <!-- Tape-deck button skin: dark brushed-plastic buttons with a warm amber accent (like a
             deck's indicator LEDs) on hover/press, applied to every Button app-wide since there's
             no reason any window should keep the default flat system-gray look on this dark skin. -->
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FF141414"/>
        <SolidColorBrush x:Key="ButtonAccentBrush" Color="#FFE0A030"/>
        <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFF0F0F0"/>
        <SolidColorBrush x:Key="ButtonDisabledTextBrush" Color="#FF7A7A7A"/>

        <LinearGradientBrush x:Key="ButtonNormalBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF5C5C5C" Offset="0"/>
            <GradientStop Color="#FF3A3A3A" Offset="0.5"/>
            <GradientStop Color="#FF2A2A2A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF6E6E6E" Offset="0"/>
            <GradientStop Color="#FF464646" Offset="0.5"/>
            <GradientStop Color="#FF343434" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonPressedBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF242424" Offset="0"/>
            <GradientStop Color="#FF1A1A1A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ButtonDisabledBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF383838" Offset="0"/>
            <GradientStop Color="#FF2A2A2A" Offset="1"/>
        </LinearGradientBrush>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonNormalBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ButtonTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ButtonBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Direction="270" ShadowDepth="1.5" BlurRadius="3" Opacity="0.55"/>
                            </Border.Effect>
                            <Grid>
                                <!-- Thin top highlight for a subtle "raised plastic" gloss. -->
                                <Border BorderBrush="#26FFFFFF" BorderThickness="0,1,0,0" CornerRadius="5,5,0,0"
                                        Margin="1,1,1,0" VerticalAlignment="Top" Height="2"/>
                                <ContentPresenter x:Name="content" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                                   RenderTransformOrigin="0.5,0.5">
                                    <ContentPresenter.RenderTransform>
                                        <TranslateTransform/>
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ButtonHoverBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource ButtonAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ButtonPressedBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource ButtonAccentBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="Black" Direction="270" ShadowDepth="0.5" BlurRadius="2" Opacity="0.3"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="content" Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform Y="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource ButtonAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ButtonDisabledBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="Effect" Value="{x:Null}"/>
                                <Setter Property="Foreground" Value="{StaticResource ButtonDisabledTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
