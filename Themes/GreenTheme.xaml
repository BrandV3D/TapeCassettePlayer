<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Green - a deep charcoal-green deck, spring-green -> lime accent thread; think phosphor
         VU-meter glow rather than the Blue theme's cool electric-navy. -->

    <SolidColorBrush x:Key="Bg0Brush" Color="#FF0A140E"/>
    <SolidColorBrush x:Key="Bg1Brush" Color="#FF101E14"/>
    <Color x:Key="PanelGradTopColor">#FF13241A</Color>
    <Color x:Key="PanelGradBottomColor">#FF06100A</Color>
    <SolidColorBrush x:Key="HairlineBrush" Color="#FF2A4A32"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFE8FFEE"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF8FCC9E"/>
    <Color x:Key="GridLineColor">#1E7FFFA3</Color>

    <Color x:Key="AccentStartColor">#FF00FFA3</Color>
    <Color x:Key="AccentMidColor">#FF4CD964</Color>
    <Color x:Key="AccentEndColor">#FFC6FF3E</Color>
    <Color x:Key="AccentGlowColor">#FF4CD964</Color>
    <SolidColorBrush x:Key="AccentStartBrush" Color="{StaticResource AccentStartColor}"/>
    <SolidColorBrush x:Key="AccentMidBrush" Color="{StaticResource AccentMidColor}"/>
    <SolidColorBrush x:Key="AccentEndBrush" Color="{StaticResource AccentEndColor}"/>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource AccentStartColor}" Offset="0"/>
        <GradientStop Color="{StaticResource AccentMidColor}" Offset="0.55"/>
        <GradientStop Color="{StaticResource AccentEndColor}" Offset="1"/>
    </LinearGradientBrush>

    <Color x:Key="AmberColor">#FFE0A030</Color>
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}"/>

    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FF06100A"/>
    <SolidColorBrush x:Key="ButtonAccentBrush" Color="{StaticResource AccentMidColor}"/>
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFE8FFEE"/>
    <SolidColorBrush x:Key="ButtonDisabledTextBrush" Color="#FF547A5E"/>
    <LinearGradientBrush x:Key="ButtonNormalBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF345C3E" Offset="0"/>
        <GradientStop Color="#FF223C2A" Offset="0.5"/>
        <GradientStop Color="#FF17281C" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF3F7048" Offset="0"/>
        <GradientStop Color="#FF2A4A34" Offset="0.5"/>
        <GradientStop Color="#FF1D3424" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonPressedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF162A1C" Offset="0"/>
        <GradientStop Color="#FF0E1C12" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonDisabledBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF223A28" Offset="0"/>
        <GradientStop Color="#FF17281C" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
