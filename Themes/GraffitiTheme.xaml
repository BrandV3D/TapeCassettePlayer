<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Graffiti - a gritty spray-painted brick wall instead of a brushed-metal deck: warm concrete
         chassis, hot-pink -> orange -> acid-yellow spray-can accent thread standing in for the
         cyan/violet/magenta one everywhere else uses. Amber becomes a punchier tag-gold to match. -->

    <SolidColorBrush x:Key="Bg0Brush" Color="#FF161210"/>
    <SolidColorBrush x:Key="Bg1Brush" Color="#FF211D18"/>
    <Color x:Key="PanelGradTopColor">#FF2C241C</Color>
    <Color x:Key="PanelGradBottomColor">#FF0E0B08</Color>
    <SolidColorBrush x:Key="HairlineBrush" Color="#FF4A4038"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF5F0E8"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFB0A08A"/>
    <Color x:Key="GridLineColor">#1EFFC700</Color>

    <Color x:Key="AccentStartColor">#FFFF2E88</Color>
    <Color x:Key="AccentMidColor">#FFFF7A1A</Color>
    <Color x:Key="AccentEndColor">#FFC6FF00</Color>
    <Color x:Key="AccentGlowColor">#FFFF5A2E</Color>
    <SolidColorBrush x:Key="AccentStartBrush" Color="{StaticResource AccentStartColor}"/>
    <SolidColorBrush x:Key="AccentMidBrush" Color="{StaticResource AccentMidColor}"/>
    <SolidColorBrush x:Key="AccentEndBrush" Color="{StaticResource AccentEndColor}"/>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource AccentStartColor}" Offset="0"/>
        <GradientStop Color="{StaticResource AccentMidColor}" Offset="0.55"/>
        <GradientStop Color="{StaticResource AccentEndColor}" Offset="1"/>
    </LinearGradientBrush>

    <Color x:Key="AmberColor">#FFFFC700</Color>
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}"/>

    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FF120F0D"/>
    <SolidColorBrush x:Key="ButtonAccentBrush" Color="{StaticResource AccentStartColor}"/>
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFF5F0E8"/>
    <SolidColorBrush x:Key="ButtonDisabledTextBrush" Color="#FF7A6E5E"/>
    <LinearGradientBrush x:Key="ButtonNormalBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF4A3E30" Offset="0"/>
        <GradientStop Color="#FF302820" Offset="0.5"/>
        <GradientStop Color="#FF1E1814" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF5E4438" Offset="0"/>
        <GradientStop Color="#FF3C2C26" Offset="0.5"/>
        <GradientStop Color="#FF261C18" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonPressedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF1A1512" Offset="0"/>
        <GradientStop Color="#FF100D0B" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonDisabledBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF2C2620" Offset="0"/>
        <GradientStop Color="#FF1E1814" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
