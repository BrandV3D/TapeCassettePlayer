<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark (default) - the original tape-deck skin: near-black chassis, brushed-plastic buttons,
         neon cyan -> violet -> magenta accent. Every other theme in this folder defines the exact
         same set of keys with different values - see ThemeManager.vb for how they're swapped. -->

    <SolidColorBrush x:Key="Bg0Brush" Color="#FF141414"/>
    <SolidColorBrush x:Key="Bg1Brush" Color="#FF1E1E1E"/>
    <Color x:Key="PanelGradTopColor">#FF121018</Color>
    <Color x:Key="PanelGradBottomColor">#FF06060A</Color>
    <SolidColorBrush x:Key="HairlineBrush" Color="#FF3A3A3A"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF8B8B96"/>
    <Color x:Key="GridLineColor">#14FFFFFF</Color>

    <Color x:Key="AccentStartColor">#FF00E5FF</Color>
    <Color x:Key="AccentMidColor">#FFB721FF</Color>
    <Color x:Key="AccentEndColor">#FFFF2D95</Color>
    <Color x:Key="AccentGlowColor">#FF9B4DFF</Color>
    <SolidColorBrush x:Key="AccentStartBrush" Color="{StaticResource AccentStartColor}"/>
    <SolidColorBrush x:Key="AccentMidBrush" Color="{StaticResource AccentMidColor}"/>
    <SolidColorBrush x:Key="AccentEndBrush" Color="{StaticResource AccentEndColor}"/>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource AccentStartColor}" Offset="0"/>
        <GradientStop Color="{StaticResource AccentMidColor}" Offset="0.55"/>
        <GradientStop Color="{StaticResource AccentEndColor}" Offset="1"/>
    </LinearGradientBrush>

    <Color x:Key="AmberColor">#FFE0A030</Color>
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}"/>

    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FF141414"/>
    <SolidColorBrush x:Key="ButtonAccentBrush" Color="{StaticResource AmberColor}"/>
    <SolidColorBrush x:Key="ButtonTextBrush" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="ButtonDisabledTextBrush" Color="#FF7A7A7A"/>
    <LinearGradientBrush x:Key="ButtonNormalBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF5C5C5C" Offset="0"/>
        <GradientStop Color="#FF3A3A3A" Offset="0.5"/>
        <GradientStop Color="#FF2A2A2A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF6E6E6E" Offset="0"/>
        <GradientStop Color="#FF464646" Offset="0.5"/>
        <GradientStop Color="#FF343434" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonPressedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF242424" Offset="0"/>
        <GradientStop Color="#FF1A1A1A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonDisabledBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF383838" Offset="0"/>
        <GradientStop Color="#FF2A2A2A" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
