<UserControl x:Class="StickersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tape_Player"
        mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="Sticker" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Direction="270" ShadowDepth="2" BlurRadius="4" Opacity="0.4"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StickerText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </UserControl.Resources>
    <!-- Purely cosmetic - a scattered sheet of retro cassette-culture badges. -->
    <Grid Background="{DynamicResource Bg1Brush}">
        <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="4" Margin="8">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{DynamicResource PanelGradTopColor}" Offset="0"/>
                    <GradientStop Color="{DynamicResource PanelGradBottomColor}" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Canvas>
                <Border Style="{StaticResource Sticker}" Canvas.Left="18" Canvas.Top="20" Background="{DynamicResource AccentEndBrush}" BorderBrush="{DynamicResource Bg0Brush}">
                    <Border.RenderTransform>
                        <RotateTransform Angle="-8"/>
                    </Border.RenderTransform>
                    <TextBlock Text="HOME TAPED" Style="{StaticResource StickerText}" Foreground="Black"/>
                </Border>
                <Border Style="{StaticResource Sticker}" Canvas.Left="150" Canvas.Top="16" Background="{DynamicResource AmberBrush}" BorderBrush="{DynamicResource Bg0Brush}">
                    <Border.RenderTransform>
                        <RotateTransform Angle="6"/>
                    </Border.RenderTransform>
                    <TextBlock Text="LOW NOISE" Style="{StaticResource StickerText}" Foreground="Black"/>
                </Border>
                <Border Style="{StaticResource Sticker}" Canvas.Left="40" Canvas.Top="90" Background="{DynamicResource AccentStartBrush}" BorderBrush="{DynamicResource Bg0Brush}">
                    <Border.RenderTransform>
                        <RotateTransform Angle="4"/>
                    </Border.RenderTransform>
                    <TextBlock Text="90 MIN" Style="{StaticResource StickerText}" Foreground="Black"/>
                </Border>
                <Border Style="{StaticResource Sticker}" Canvas.Left="185" Canvas.Top="100" Background="{DynamicResource AccentMidBrush}" BorderBrush="{DynamicResource Bg0Brush}">
                    <Border.RenderTransform>
                        <RotateTransform Angle="-5"/>
                    </Border.RenderTransform>
                    <TextBlock Text="HI-FI STEREO" Style="{StaticResource StickerText}" Foreground="White"/>
                </Border>
                <Border Style="{StaticResource Sticker}" Canvas.Left="95" Canvas.Top="160" Background="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource Bg0Brush}">
                    <Border.RenderTransform>
                        <RotateTransform Angle="-3"/>
                    </Border.RenderTransform>
                    <TextBlock Text="SIDE A / SIDE B" Style="{StaticResource StickerText}" Foreground="{DynamicResource Bg0Brush}"/>
                </Border>
            </Canvas>
        </Border>
    </Grid>
</UserControl>
