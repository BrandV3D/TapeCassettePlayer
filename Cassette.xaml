<Window x:Class="Cassette"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tape_Player"
        mc:Ignorable="d"
        Title="Cassette" Height="450" Width="770"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Closing="Cassette_Closing" Loaded="Cassette_Loaded">
    <Viewbox Stretch="Uniform">
        <Grid Width="800" Height="450">
            <Grid.RowDefinitions>
                <RowDefinition Height="44*"/>
                <RowDefinition Height="181*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="99*"/>
                <ColumnDefinition Width="209*"/>
                <ColumnDefinition Width="55*"/>
                <ColumnDefinition Width="437*"/>
            </Grid.ColumnDefinitions>
            <Image x:Name="background" Grid.ColumnSpan="4" Margin="-13,3,-52,-40" Stretch="Fill" Grid.RowSpan="2" Source="/Tape207.png"/>
            <Image Grid.Column="2" Grid.ColumnSpan="2" Margin="2,71,306,220" Grid.Row="1" Source="/BlockM2.png" Stretch="Fill"/>
            <Image x:Name="StretchSongItem" Margin="102,73,324,218" Stretch="Fill" Source="/NewFilmTapeBailBrown.png" RenderTransformOrigin="1,0.5" Grid.Column="3" Grid.Row="1">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="StretchScaleTransform"/>
                        <SkewTransform/>
                        <RotateTransform Angle="0"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
            <Image x:Name="center" Grid.ColumnSpan="2" Margin="2,64,306,203" Source="/New Project (1).png" Stretch="Fill" Grid.Row="1" Grid.Column="2"/>
            <Image x:Name="right_wheel" Margin="158,63,179,199" Source="/WHEELSMALLFINALBULB.png" Stretch="Fill" RenderTransformOrigin="0.5,0.5" Grid.Column="3" Grid.Row="1" Width="100" Height="100">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform x:Name="RightWheelRotateTransform" Angle="0"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
            <Image x:Name="left_wheel" Margin="85,60,24,202" Source="/WHEELSMALLFINALBULB.png" Stretch="Fill" RenderTransformOrigin="0.5,0.5" Grid.Row="1" Grid.Column="1" Width="100" Height="100">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform x:Name="LeftWheelRotateTransform" Angle="0"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>

            <MediaElement x:Name="AudioPlayer" LoadedBehavior="Manual" Visibility="Collapsed" MediaOpened="AudioPlayer_MediaOpened" MediaEnded="AudioPlayer_MediaEnded" MediaFailed="AudioPlayer_MediaFailed" Grid.ColumnSpan="4" Margin="33,52,-37,-8" Grid.RowSpan="2"/>
            <Image x:Name="Lines_Copy1" Grid.Column="2" Margin="50,77,349,253" Source="/LineTrans.png" Stretch="Fill" RenderTransformOrigin="0.5,0.5" Opacity="0.85" Grid.Row="1" Grid.ColumnSpan="2">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="LinesScaleTransform"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>

            <!-- TODO: placeholder only (invisible) - replace Source/Margin with the real visual for this element. -->
            <Image x:Name="CenterWindow_Copy" Visibility="Collapsed" Source="/FillerColor2.png" Stretch="Fill" Grid.RowSpan="2" Margin="4,52,50,-8" Grid.ColumnSpan="3">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform x:Name="CenterWindowCopyTranslateTransform"/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>
            <Image x:Name="WheelBubRight" Grid.Column="3" Margin="182,88,208,229" Grid.Row="1" Source="/WheelBub.png" Stretch="Fill" d:IsHidden="True"/>
            <Image x:Name="WheelBubLeft" Grid.Column="1" Margin="109,88,53,229" Grid.Row="1" Source="/WheelBub.png" Stretch="Fill" d:IsHidden="True"/>
        </Grid>
    </Viewbox>
</Window>
