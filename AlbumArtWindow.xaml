<Window x:Class="AlbumArtWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tape_Player"
        mc:Ignorable="d"
        Title="Album Art" Width="300" Height="330" ResizeMode="CanResize"
        Background="#FF1E1E1E">
    <Border BorderBrush="#FF3A3A3A" BorderThickness="1" Background="#FF141414" Margin="8">
        <Image x:Name="ArtImage" Stretch="Uniform" Margin="4"/>
    </Border>
</Window>
