<UserControl x:Class="TapeCounterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tape_Player"
        mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="Digit" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg0Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="1,0"/>
        </Style>
        <Style x:Key="DigitText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Foreground" Value="{DynamicResource AmberBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <!-- Purely cosmetic - the little mechanical wheel-counter every real tape deck has, frozen on a
         fun readout instead of tracking real position (that's what the Controls panel's time display
         already does). -->
    <Grid Background="{DynamicResource Bg1Brush}">
        <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="4" Margin="8">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{DynamicResource PanelGradTopColor}" Offset="0"/>
                    <GradientStop Color="{DynamicResource PanelGradBottomColor}" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Style="{StaticResource Digit}"><TextBlock Text="0" Style="{StaticResource DigitText}"/></Border>
                    <Border Style="{StaticResource Digit}"><TextBlock Text="1" Style="{StaticResource DigitText}"/></Border>
                    <Border Style="{StaticResource Digit}"><TextBlock Text="4" Style="{StaticResource DigitText}"/></Border>
                    <Border Style="{StaticResource Digit}"><TextBlock Text="2" Style="{StaticResource DigitText}"/></Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <TextBlock Text="MECHANICAL COUNTER" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <Ellipse Width="16" Height="16" Stroke="{DynamicResource HairlineBrush}" StrokeThickness="1.5"/>
                    <TextBlock Text="RESET" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
