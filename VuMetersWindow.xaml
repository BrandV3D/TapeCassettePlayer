<UserControl x:Class="VuMetersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tape_Player"
        mc:Ignorable="d">
    <!-- Purely cosmetic - twin analog VU needles, idly swaying (not driven by real audio levels,
         same spirit as the Equalizer/Visualizer's simulated motion). -->
    <Grid Background="{DynamicResource Bg1Brush}">
        <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="4" Margin="8">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{DynamicResource PanelGradTopColor}" Offset="0"/>
                    <GradientStop Color="{DynamicResource PanelGradBottomColor}" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                <StackPanel Margin="18,0" HorizontalAlignment="Center">
                    <Canvas Width="140" Height="90">
                        <Line X1="70" Y1="85" X2="21" Y2="42" Stroke="{DynamicResource HairlineBrush}" StrokeThickness="2"/>
                        <Line X1="70" Y1="85" X2="45" Y2="27" Stroke="{DynamicResource HairlineBrush}" StrokeThickness="2"/>
                        <Line X1="70" Y1="85" X2="70" Y2="20" Stroke="{DynamicResource HairlineBrush}" StrokeThickness="2"/>
                        <Line X1="70" Y1="85" X2="95" Y2="27" Stroke="{DynamicResource HairlineBrush}" StrokeThickness="2"/>
                        <Line X1="70" Y1="85" X2="115" Y2="40" Stroke="{DynamicResource AccentEndBrush}" StrokeThickness="2.5"/>
                        <Line X1="70" Y1="85" X2="122" Y2="58" Stroke="{DynamicResource AccentEndBrush}" StrokeThickness="2.5"/>
                        <Line x:Name="LeftNeedle" X1="70" Y1="85" X2="70" Y2="25" Stroke="{DynamicResource AmberBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                            <Line.RenderTransform>
                                <RotateTransform x:Name="LeftNeedleRotate" CenterX="70" CenterY="85" Angle="-22"/>
                            </Line.RenderTransform>
                        </Line>
                        <Ellipse Canvas.Left="65" Canvas.Top="80" Width="10" Height="10" Fill="{DynamicResource AmberBrush}"/>
                    </Canvas>
                    <TextBlock Text="L" HorizontalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Margin="18,0" HorizontalAlignment="Center">
                    <Canvas Width="140" Height="90">
                        <Line X1="70" Y1="85" X2="21" Y2="42" Stroke="{DynamicResource HairlineBrush}" StrokeThickness="2"/>
                        <Line X1="70" Y1="85" X2="45" Y2="27" Stroke="{DynamicResource HairlineBrush}" StrokeThickness="2"/>
                        <Line X1="70" Y1="85" X2="70" Y2="20" Stroke="{DynamicResource HairlineBrush}" StrokeThickness="2"/>
                        <Line X1="70" Y1="85" X2="95" Y2="27" Stroke="{DynamicResource HairlineBrush}" StrokeThickness="2"/>
                        <Line X1="70" Y1="85" X2="115" Y2="40" Stroke="{DynamicResource AccentEndBrush}" StrokeThickness="2.5"/>
                        <Line X1="70" Y1="85" X2="122" Y2="58" Stroke="{DynamicResource AccentEndBrush}" StrokeThickness="2.5"/>
                        <Line x:Name="RightNeedle" X1="70" Y1="85" X2="70" Y2="25" Stroke="{DynamicResource AmberBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                            <Line.RenderTransform>
                                <RotateTransform x:Name="RightNeedleRotate" CenterX="70" CenterY="85" Angle="8"/>
                            </Line.RenderTransform>
                        </Line>
                        <Ellipse Canvas.Left="65" Canvas.Top="80" Width="10" Height="10" Fill="{DynamicResource AmberBrush}"/>
                    </Canvas>
                    <TextBlock Text="R" HorizontalAlignment="Center" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
