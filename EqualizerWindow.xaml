<UserControl x:Class="EqualizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tape_Player"
        mc:Ignorable="d">
    <Grid Background="{DynamicResource Bg1Brush}">
    <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="4" Margin="8">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{DynamicResource PanelGradTopColor}" Offset="0"/>
                <GradientStop Color="{DynamicResource PanelGradBottomColor}" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid x:Name="EqRoot" ClipToBounds="True">
            <Canvas x:Name="GridLinesCanvas"/>
            <Canvas x:Name="BarsCanvas">
                <Canvas.Effect>
                    <DropShadowEffect x:Name="GlowEffect" Color="{DynamicResource AccentGlowColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>
                </Canvas.Effect>
            </Canvas>
        </Grid>
    </Border>
    </Grid>
</UserControl>
