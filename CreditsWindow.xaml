<UserControl x:Class="CreditsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tape_Player"
        mc:Ignorable="d">
    <!-- Purely cosmetic - an about/credits card reusing the title bar's reel-hub mark. -->
    <Grid Background="{DynamicResource Bg1Brush}">
        <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1" CornerRadius="4" Margin="8">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{DynamicResource PanelGradTopColor}" Offset="0"/>
                    <GradientStop Color="{DynamicResource PanelGradBottomColor}" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Viewbox Width="44" Height="44" HorizontalAlignment="Center">
                    <Canvas Width="40" Height="40">
                        <Ellipse Width="34" Height="34" Canvas.Left="3" Canvas.Top="3"
                                  Stroke="{DynamicResource AccentGradientBrush}" StrokeThickness="2.4"/>
                        <Ellipse Width="14" Height="14" Canvas.Left="13" Canvas.Top="13"
                                  Fill="{DynamicResource Bg0Brush}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="2"/>
                        <Ellipse Width="4" Height="4" Canvas.Left="18" Canvas.Top="18" Fill="{DynamicResource TextSecondaryBrush}"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="TAPE CASSETTE PLAYER" FontFamily="pack://application:,,,/Fonts/#Chakra Petch"
                           FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AccentGradientBrush}"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock Text="a customizable, dockable desktop tape deck" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                <TextBlock Text="Built with ♥ and 90 minutes of blank tape." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,14,0,0" Opacity="0.8"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
