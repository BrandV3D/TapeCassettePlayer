<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tape_Player"
        xmlns:xcad="https://github.com/Dirkster99/AvalonDock"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Tape Cassette Player" Height="820" Width="1400" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        Background="{DynamicResource Bg0Brush}"
        Closing="MainWindow_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Slim caption buttons (minimize/maximize/close) - deliberately NOT the app-wide gradient
             Button style from Application.xaml, since that's sized for the tape-deck transport
             controls, not a title bar. An explicit Style always overrides an implicit TargetType
             one, so setting this by key on each button opts it out cleanly. -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFE81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionGlyphStyle" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="StrokeThickness" Value="1.1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar. WindowChrome treats everything in this row as the caption area
             (drag to move, double-click to maximize/restore) except the buttons, which opt out
             via IsHitTestVisibleInChrome above. -->
        <Border Grid.Row="0" Background="{DynamicResource Bg0Brush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Reel-hub mark + wordmark -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Viewbox Width="20" Height="20" Margin="0,0,10,0">
                        <Canvas Width="40" Height="40">
                            <Ellipse Width="34" Height="34" Canvas.Left="3" Canvas.Top="3"
                                      Stroke="{DynamicResource AccentGradientBrush}" StrokeThickness="2.4"/>
                            <Ellipse Width="14" Height="14" Canvas.Left="13" Canvas.Top="13"
                                      Fill="{DynamicResource Bg0Brush}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="2"/>
                            <Ellipse Width="4" Height="4" Canvas.Left="18" Canvas.Top="18" Fill="{DynamicResource TextSecondaryBrush}"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="TAPE CASSETTE PLAYER" FontFamily="pack://application:,,,/Fonts/#Chakra Petch"
                               FontWeight="Bold" FontSize="17" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentGradientBrush}">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{DynamicResource AccentGlowColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.45"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <!-- Caption buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}" Click="MinimizeButton_Click" ToolTip="Minimize">
                        <Path Style="{StaticResource CaptionGlyphStyle}" Data="M 0,0 L 10,0"/>
                    </Button>
                    <Button x:Name="MaximizeRestoreButton" Style="{StaticResource CaptionButtonStyle}" Click="MaximizeRestoreButton_Click" ToolTip="Maximize">
                        <Grid Width="10" Height="10">
                            <Path x:Name="MaximizeGlyph" Style="{StaticResource CaptionGlyphStyle}" Data="M 0,0 L 10,0 L 10,10 L 0,10 Z"/>
                            <Canvas x:Name="RestoreGlyph" Visibility="Collapsed">
                                <Path Style="{StaticResource CaptionGlyphStyle}" Data="M 2,0 L 10,0 L 10,8 L 8,8"/>
                                <Path Style="{StaticResource CaptionGlyphStyle}" Data="M 0,2 L 8,2 L 8,10 L 0,10 L 0,2 Z"/>
                            </Canvas>
                        </Grid>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CloseButtonStyle}" Click="CloseButton_Click" ToolTip="Close">
                        <Path Style="{StaticResource CaptionGlyphStyle}" Data="M 0,0 L 10,10 M 10,0 L 0,10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Every panel is a freely dockable/floatable/closable AvalonDock pane instead of a fixed
             grid slot - this starting arrangement is just where the panes happen to sit on launch;
             the user can drag, float, resize, tab-group, or auto-hide any of them from here. Three
             columns: Spectrum/Visualizer with Playlist underneath; the cassette deck with its own
             transport Controls underneath (the pairing you'd expect on an actual machine); and the
             Graphic Equalizer tabbed with Album Art. Everything that isn't part of the everyday
             play/pause loop (Theme, Credits, and the cosmetic panels) starts tucked into an
             auto-hidden bay along the left edge rather than crowding out those three columns. -->
        <xcad:DockingManager Grid.Row="1" x:Name="Dock" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
            <xcad:LayoutRoot>

                <xcad:LayoutRoot.LeftSide>
                    <xcad:LayoutAnchorSide>
                        <xcad:LayoutAnchorGroup>
                            <xcad:LayoutAnchorable x:Name="ThemePane" Title="Theme" CanClose="True" CanFloat="True"
                                                    AutoHideWidth="300" FloatingWidth="360" FloatingHeight="260"/>
                            <xcad:LayoutAnchorable x:Name="CreditsPane" Title="Credits" CanClose="True" CanFloat="True"
                                                    AutoHideWidth="300" FloatingWidth="320" FloatingHeight="260"/>
                            <xcad:LayoutAnchorable x:Name="LinerNotesPane" Title="Liner Notes" CanClose="True" CanFloat="True"
                                                    AutoHideWidth="300" FloatingWidth="320" FloatingHeight="300"/>
                            <xcad:LayoutAnchorable x:Name="VuMetersPane" Title="VU Meters" CanClose="True" CanFloat="True"
                                                    AutoHideWidth="300" FloatingWidth="360" FloatingHeight="220"/>
                            <xcad:LayoutAnchorable x:Name="TapeCounterPane" Title="Tape Counter" CanClose="True" CanFloat="True"
                                                    AutoHideWidth="300" FloatingWidth="320" FloatingHeight="220"/>
                            <xcad:LayoutAnchorable x:Name="StickersPane" Title="Stickers" CanClose="True" CanFloat="True"
                                                    AutoHideWidth="300" FloatingWidth="320" FloatingHeight="260"/>
                            <xcad:LayoutAnchorable x:Name="ConcertPosterPane" Title="Live on Tape" CanClose="True" CanFloat="True"
                                                    AutoHideWidth="300" FloatingWidth="300" FloatingHeight="320"/>
                            <xcad:LayoutAnchorable x:Name="RetroAdPane" Title="Retro Ad" CanClose="True" CanFloat="True"
                                                    AutoHideWidth="300" FloatingWidth="340" FloatingHeight="320"/>
                            <xcad:LayoutAnchorable x:Name="StaticNoisePane" Title="Static" CanClose="True" CanFloat="True"
                                                    AutoHideWidth="300" FloatingWidth="360" FloatingHeight="220"/>
                        </xcad:LayoutAnchorGroup>
                    </xcad:LayoutAnchorSide>
                </xcad:LayoutRoot.LeftSide>

                <xcad:LayoutPanel Orientation="Horizontal">

                    <!-- Left: Visualizer/Spectrum tabbed together, Playlist underneath. -->
                    <xcad:LayoutPanel Orientation="Vertical" DockWidth="340">
                        <xcad:LayoutAnchorablePane DockHeight="*">
                            <xcad:LayoutAnchorable x:Name="VisualizerPane" Title="Visualizer" CanClose="True" CanFloat="True"
                                                    FloatingWidth="460" FloatingHeight="260"/>
                            <xcad:LayoutAnchorable x:Name="EqualizerPane" Title="Spectrum" CanClose="True" CanFloat="True"
                                                    FloatingWidth="460" FloatingHeight="260" IsActive="True"/>
                        </xcad:LayoutAnchorablePane>
                        <xcad:LayoutAnchorablePane DockHeight="220">
                            <xcad:LayoutAnchorable x:Name="PlaylistPane" Title="Playlist" CanClose="True" CanFloat="True"
                                                    FloatingWidth="500" FloatingHeight="260"/>
                        </xcad:LayoutAnchorablePane>
                    </xcad:LayoutPanel>

                    <!-- Middle: the cassette itself, transport Controls right underneath. -->
                    <xcad:LayoutPanel Orientation="Vertical" DockWidth="480">
                        <xcad:LayoutAnchorablePane DockHeight="*">
                            <xcad:LayoutAnchorable x:Name="CassettePane" Title="Cassette" CanClose="True" CanFloat="True"
                                                    FloatingWidth="770" FloatingHeight="450"/>
                        </xcad:LayoutAnchorablePane>
                        <xcad:LayoutAnchorablePane DockHeight="180">
                            <xcad:LayoutAnchorable x:Name="ControlsPane" Title="Controls" CanClose="True" CanFloat="True"
                                                    FloatingWidth="620" FloatingHeight="220"/>
                        </xcad:LayoutAnchorablePane>
                    </xcad:LayoutPanel>

                    <!-- Right: Graphic Equalizer tabbed with Album Art, filling the full column height. -->
                    <xcad:LayoutPanel Orientation="Vertical" DockWidth="380">
                        <xcad:LayoutAnchorablePane DockHeight="*">
                            <xcad:LayoutAnchorable x:Name="EqualizerControlsPane" Title="Graphic Equalizer" CanClose="True" CanFloat="True"
                                                    FloatingWidth="660" FloatingHeight="360"/>
                            <xcad:LayoutAnchorable x:Name="AlbumArtPane" Title="Album Art" CanClose="True" CanFloat="True"
                                                    FloatingWidth="340" FloatingHeight="380" IsActive="True"/>
                        </xcad:LayoutAnchorablePane>
                    </xcad:LayoutPanel>

                </xcad:LayoutPanel>
            </xcad:LayoutRoot>
        </xcad:DockingManager>
    </Grid>
</Window>
