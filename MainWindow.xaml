<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tape_Player"
        xmlns:xcad="https://github.com/Dirkster99/AvalonDock"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Tape Cassette Player" Height="820" Width="1360" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        Background="#FF141414"
        Closing="MainWindow_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- The wordmark's cyan -> violet -> magenta thread, matching the Equalizer/Visualizer glow. -->
        <LinearGradientBrush x:Key="TapeGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF00E5FF" Offset="0"/>
            <GradientStop Color="#FFB721FF" Offset="0.55"/>
            <GradientStop Color="#FFFF2D95" Offset="1"/>
        </LinearGradientBrush>

        <!-- Slim caption buttons (minimize/maximize/close) - deliberately NOT the app-wide gradient
             Button style from Application.xaml, since that's sized for the tape-deck transport
             controls, not a title bar. An explicit Style always overrides an implicit TargetType
             one, so setting this by key on each button opts it out cleanly. -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#FFC8C8CE"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFE81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionGlyphStyle" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="StrokeThickness" Value="1.1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar. WindowChrome treats everything in this row as the caption area
             (drag to move, double-click to maximize/restore) except the buttons, which opt out
             via IsHitTestVisibleInChrome above. -->
        <Border Grid.Row="0" Background="#FF0E0E12" BorderBrush="#FF2C2C34" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Reel-hub mark + wordmark -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Viewbox Width="20" Height="20" Margin="0,0,10,0">
                        <Canvas Width="40" Height="40">
                            <Ellipse Width="34" Height="34" Canvas.Left="3" Canvas.Top="3"
                                      Stroke="{StaticResource TapeGradient}" StrokeThickness="2.4"/>
                            <Ellipse Width="14" Height="14" Canvas.Left="13" Canvas.Top="13"
                                      Fill="#FF0E0E12" Stroke="#FF8B8B96" StrokeThickness="2"/>
                            <Ellipse Width="4" Height="4" Canvas.Left="18" Canvas.Top="18" Fill="#FF8B8B96"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="TAPE CASSETTE PLAYER" FontFamily="pack://application:,,,/Fonts/#Chakra Petch"
                               FontWeight="Bold" FontSize="17" VerticalAlignment="Center"
                               Foreground="{StaticResource TapeGradient}">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FF9B4DFF" BlurRadius="12" ShadowDepth="0" Opacity="0.45"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <!-- Caption buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}" Click="MinimizeButton_Click" ToolTip="Minimize">
                        <Path Style="{StaticResource CaptionGlyphStyle}" Data="M 0,0 L 10,0"/>
                    </Button>
                    <Button x:Name="MaximizeRestoreButton" Style="{StaticResource CaptionButtonStyle}" Click="MaximizeRestoreButton_Click" ToolTip="Maximize">
                        <Grid Width="10" Height="10">
                            <Path x:Name="MaximizeGlyph" Style="{StaticResource CaptionGlyphStyle}" Data="M 0,0 L 10,0 L 10,10 L 0,10 Z"/>
                            <Canvas x:Name="RestoreGlyph" Visibility="Collapsed">
                                <Path Style="{StaticResource CaptionGlyphStyle}" Data="M 2,0 L 10,0 L 10,8 L 8,8"/>
                                <Path Style="{StaticResource CaptionGlyphStyle}" Data="M 0,2 L 8,2 L 8,10 L 0,10 L 0,2 Z"/>
                            </Canvas>
                        </Grid>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CloseButtonStyle}" Click="CloseButton_Click" ToolTip="Close">
                        <Path Style="{StaticResource CaptionGlyphStyle}" Data="M 0,0 L 10,10 M 10,0 L 0,10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <xcad:DockingManager Grid.Row="1" x:Name="Dock" AllowMixedOrientation="True" BorderBrush="#FF3A3A3A" BorderThickness="1">
            <!-- Deliberate three-column arrangement, not a flat grid of equal boxes: the tape deck
                 is the visual center of the app, so Cassette anchors the middle column with its own
                 transport Controls stacked directly underneath it - the pairing you'd expect on an
                 actual deck. The left column pairs the live Spectrum readout with the Graphic
                 Equalizer that's shaping it; the right column mirrors that same "meter over its
                 controls" idea with Album Art over the Visualizer. Playlist spans the full width
                 along the bottom, since a track list reads better wide than boxed into a column. -->
            <xcad:LayoutRoot>
                <xcad:LayoutPanel Orientation="Vertical">
                    <xcad:LayoutPanel Orientation="Horizontal" DockHeight="620">

                        <!-- Left column: Spectrum meter over the Graphic Equalizer that drives it -->
                        <xcad:LayoutPanel Orientation="Vertical" DockWidth="380">
                            <xcad:LayoutAnchorablePane DockHeight="300">
                                <xcad:LayoutAnchorable x:Name="EqualizerPane" Title="Spectrum" CanClose="False" CanFloat="True"
                                                        FloatingWidth="460" FloatingHeight="260"/>
                            </xcad:LayoutAnchorablePane>
                            <xcad:LayoutAnchorablePane DockHeight="320">
                                <xcad:LayoutAnchorable x:Name="EqualizerControlsPane" Title="Graphic Equalizer" CanClose="False" CanFloat="True"
                                                        FloatingWidth="660" FloatingHeight="360"/>
                            </xcad:LayoutAnchorablePane>
                        </xcad:LayoutPanel>

                        <!-- Center column: the cassette itself, transport Controls right underneath -->
                        <xcad:LayoutPanel Orientation="Vertical" DockWidth="580">
                            <xcad:LayoutAnchorablePane DockHeight="440">
                                <xcad:LayoutAnchorable x:Name="CassettePane" Title="Cassette" CanClose="False" CanFloat="True"
                                                        FloatingWidth="770" FloatingHeight="450"/>
                            </xcad:LayoutAnchorablePane>
                            <xcad:LayoutAnchorablePane DockHeight="180">
                                <xcad:LayoutAnchorable x:Name="ControlsPane" Title="Controls" CanClose="False" CanFloat="True"
                                                        FloatingWidth="620" FloatingHeight="220"/>
                            </xcad:LayoutAnchorablePane>
                        </xcad:LayoutPanel>

                        <!-- Right column: Album Art over the Visualizer, mirroring the left column -->
                        <xcad:LayoutPanel Orientation="Vertical" DockWidth="380">
                            <xcad:LayoutAnchorablePane DockHeight="340">
                                <xcad:LayoutAnchorable x:Name="AlbumArtPane" Title="Album Art" CanClose="False" CanFloat="True"
                                                        FloatingWidth="300" FloatingHeight="330"/>
                            </xcad:LayoutAnchorablePane>
                            <xcad:LayoutAnchorablePane DockHeight="280">
                                <xcad:LayoutAnchorable x:Name="VisualizerPane" Title="Visualizer" CanClose="False" CanFloat="True"
                                                        FloatingWidth="460" FloatingHeight="220"/>
                            </xcad:LayoutAnchorablePane>
                        </xcad:LayoutPanel>

                    </xcad:LayoutPanel>

                    <!-- Footer: Playlist, full width -->
                    <xcad:LayoutAnchorablePane DockHeight="180">
                        <xcad:LayoutAnchorable x:Name="PlaylistPane" Title="Playlist" CanClose="False" CanFloat="True"
                                                FloatingWidth="500" FloatingHeight="220"/>
                    </xcad:LayoutAnchorablePane>
                </xcad:LayoutPanel>
            </xcad:LayoutRoot>
        </xcad:DockingManager>
    </Grid>
</Window>
