<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tape_Player"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Tape Cassette Player" Height="800" Width="1180" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        Background="{DynamicResource Bg0Brush}"
        Closing="MainWindow_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Slim caption buttons (minimize/maximize/close) - deliberately NOT the app-wide gradient
             Button style from Application.xaml, since that's sized for the tape-deck transport
             controls, not a title bar. An explicit Style always overrides an implicit TargetType
             one, so setting this by key on each button opts it out cleanly. -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFE81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionGlyphStyle" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="StrokeThickness" Value="1.1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Flat, underline-selected tabs for the right-hand panel - deliberately not the default
             WPF tab chrome (raised 3D folder tabs), which would look dated next to everything else
             here. Closer to the flat text-tab pattern most streaming apps use for secondary views. -->
        <Style TargetType="TabPanel">
            <Setter Property="Background" Value="{DynamicResource Bg0Brush}"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="3"/>
                            </Grid.RowDefinitions>
                            <ContentPresenter x:Name="Header" ContentSource="Header" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            <Rectangle x:Name="Indicator" Grid.Row="1" Fill="{DynamicResource AccentGradientBrush}" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Indicator" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Drag handles between regions - a hairline at rest, lit up in the accent color under the
             cursor/while dragging so it's obvious it's grabbable, same idea as a real mixer's panel
             seams. -->
        <Style x:Key="VerticalSplitter" TargetType="GridSplitter">
            <Setter Property="Background" Value="{DynamicResource HairlineBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentStartBrush}"/>
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentStartBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HorizontalSplitter" TargetType="GridSplitter" BasedOn="{StaticResource VerticalSplitter}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="SizeNS"/>
            <Setter Property="ResizeDirection" Value="Rows"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar. WindowChrome treats everything in this row as the caption area
             (drag to move, double-click to maximize/restore) except the buttons, which opt out
             via IsHitTestVisibleInChrome above. -->
        <Border Grid.Row="0" Background="{DynamicResource Bg0Brush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Reel-hub mark + wordmark -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Viewbox Width="20" Height="20" Margin="0,0,10,0">
                        <Canvas Width="40" Height="40">
                            <Ellipse Width="34" Height="34" Canvas.Left="3" Canvas.Top="3"
                                      Stroke="{DynamicResource AccentGradientBrush}" StrokeThickness="2.4"/>
                            <Ellipse Width="14" Height="14" Canvas.Left="13" Canvas.Top="13"
                                      Fill="{DynamicResource Bg0Brush}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="2"/>
                            <Ellipse Width="4" Height="4" Canvas.Left="18" Canvas.Top="18" Fill="{DynamicResource TextSecondaryBrush}"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="TAPE CASSETTE PLAYER" FontFamily="pack://application:,,,/Fonts/#Chakra Petch"
                               FontWeight="Bold" FontSize="17" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentGradientBrush}">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{DynamicResource AccentGlowColor}" BlurRadius="12" ShadowDepth="0" Opacity="0.45"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>

                <!-- Caption buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}" Click="MinimizeButton_Click" ToolTip="Minimize">
                        <Path Style="{StaticResource CaptionGlyphStyle}" Data="M 0,0 L 10,0"/>
                    </Button>
                    <Button x:Name="MaximizeRestoreButton" Style="{StaticResource CaptionButtonStyle}" Click="MaximizeRestoreButton_Click" ToolTip="Maximize">
                        <Grid Width="10" Height="10">
                            <Path x:Name="MaximizeGlyph" Style="{StaticResource CaptionGlyphStyle}" Data="M 0,0 L 10,0 L 10,10 L 0,10 Z"/>
                            <Canvas x:Name="RestoreGlyph" Visibility="Collapsed">
                                <Path Style="{StaticResource CaptionGlyphStyle}" Data="M 2,0 L 10,0 L 10,8 L 8,8"/>
                                <Path Style="{StaticResource CaptionGlyphStyle}" Data="M 0,2 L 8,2 L 8,10 L 0,10 L 0,2 Z"/>
                            </Canvas>
                        </Grid>
                    </Button>
                    <Button x:Name="CloseButton" Style="{StaticResource CloseButtonStyle}" Click="CloseButton_Click" ToolTip="Close">
                        <Path Style="{StaticResource CaptionGlyphStyle}" Data="M 0,0 L 10,10 M 10,0 L 0,10"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- One fixed, non-dockable layout instead of freely-arrangeable panes - the shape most
             music players actually use: a now-playing centerpiece with its own transport bar
             directly underneath (the deck-and-its-own-controls pairing you'd expect on an actual
             machine), the live Spectrum equalizer with the Playlist underneath it, and a tab strip
             for the panels that aren't part of the everyday play/pause loop. Album Art always lives
             in its own separate window (see MainWindow.xaml.vb) rather than a column here. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="300" MinWidth="240" MaxWidth="460"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="340" MinWidth="260" MaxWidth="560"/>
            </Grid.ColumnDefinitions>

            <!-- Center: the cassette itself, with its own transport Controls directly underneath -
                 a nested Grid so that split stays scoped to just this column. -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="220"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="140" MinHeight="90" MaxHeight="260"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource Bg0Brush}"
                        BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1,0">
                    <ContentControl x:Name="CassetteHost" Margin="16"/>
                </Border>

                <GridSplitter Grid.Row="1" Style="{StaticResource HorizontalSplitter}"/>

                <Border Grid.Row="2" Background="{DynamicResource Bg0Brush}"
                        BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1,1,1,0">
                    <ContentControl x:Name="ControlsHost"/>
                </Border>
            </Grid>

            <!-- Drag handles between every region - the layout itself is fixed (no floating/docking
                 anymore, see the redesign note above), but every split here is still resizable. -->
            <GridSplitter Grid.Column="1" Style="{StaticResource VerticalSplitter}"/>

            <!-- Spectrum equalizer with the Playlist underneath it - a nested Grid so that split
                 stays scoped to just this column. -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="160"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="220" MinHeight="120" MaxHeight="420"/>
                </Grid.RowDefinitions>

                <ContentControl x:Name="EqualizerHost" Grid.Row="0"/>

                <GridSplitter Grid.Row="1" Style="{StaticResource HorizontalSplitter}"/>

                <DockPanel Grid.Row="2" Background="{DynamicResource Bg1Brush}" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="PLAYLIST" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="14,12,14,6"/>
                    <ContentControl x:Name="PlaylistHost"/>
                </DockPanel>
            </Grid>

            <GridSplitter Grid.Column="3" Style="{StaticResource VerticalSplitter}"/>

            <!-- Right: a tab strip for everything that isn't part of the everyday play/pause loop. -->
            <TabControl Grid.Column="4" Background="{DynamicResource Bg1Brush}" BorderThickness="0">
                <TabItem Header="EQUALIZER">
                    <Grid Background="{DynamicResource Bg1Brush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1.3*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ContentControl x:Name="EqualizerControlsHost" Grid.Row="0"/>
                        <ContentControl x:Name="VuMetersHost" Grid.Row="1"/>
                    </Grid>
                </TabItem>
                <TabItem Header="SCOPE">
                    <Grid Background="{DynamicResource Bg1Brush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="0.8*"/>
                        </Grid.RowDefinitions>
                        <ContentControl x:Name="VisualizerHost" Grid.Row="0"/>
                        <ContentControl x:Name="TapeCounterHost" Grid.Row="1"/>
                    </Grid>
                </TabItem>
                <TabItem Header="STYLE">
                    <ScrollViewer Background="{DynamicResource Bg1Brush}" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ContentControl x:Name="ThemeHost" Height="220"/>
                            <ContentControl x:Name="CreditsHost" Height="200"/>
                            <ContentControl x:Name="StickersHost" Height="220"/>
                            <ContentControl x:Name="LinerNotesHost" Height="260"/>
                            <ContentControl x:Name="ConcertPosterHost" Height="260"/>
                            <ContentControl x:Name="RetroAdHost" Height="280"/>
                            <ContentControl x:Name="StaticNoiseHost" Height="200"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
